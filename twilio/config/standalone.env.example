# Path A — standalone Messages app
# Example bundle identifiers: replace with registered identifiers before use.
# Use the App Store ID belonging to THIS product. All real identities remain unset.
# Configure through the Twilio CLI profile / Functions environment. Never commit secrets.
# Account credentials are supplied by the Twilio Functions environment.
AMB_ENABLE_LIVE_DELIVERY=false
NATIVE_DEFAULT_COMPONENT=bar
PUBLIC_BASE_URL=
APPLE_TEAM_ID=
# App/wrapper identifier is reference metadata for the selected product.
# Only optional App Clip routes currently consume APPLE_APP_BUNDLE_ID.
APPLE_APP_BUNDLE_ID=com.example.ChartConciergeMessages
APPLE_APP_CLIP_BUNDLE_ID=
APPLE_EXTENSION_BUNDLE_ID=com.example.ChartConciergeMessages.Messages
APPLE_APP_STORE_ID=
APPLE_APP_NAME=Chart Concierge
AMB_BUSINESS_SENDER=
# One consenting internal test conversation, from a verified incoming AMB event.
AMB_TEST_RECIPIENT=
# Create a Sync service + map in Twilio Console; do not set a TTL on this map.
SYNC_SERVICE_SID=
SYNC_MAP_SID=
