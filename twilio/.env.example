# Configure through the Twilio CLI profile / Functions environment. Never commit secrets.
# Account credentials are supplied by the Twilio Functions environment.
AMB_ENABLE_LIVE_DELIVERY=false
NATIVE_DEFAULT_COMPONENT=bar
PUBLIC_BASE_URL=
APPLE_TEAM_ID=
# Optional App Clip experiment only; not required for the iMessage extension.
APPLE_APP_BUNDLE_ID=
APPLE_APP_CLIP_BUNDLE_ID=
APPLE_EXTENSION_BUNDLE_ID=
APPLE_APP_STORE_ID=
APPLE_APP_NAME=Chart Concierge
AMB_BUSINESS_SENDER=
# One consenting internal test conversation, from a verified incoming AMB event.
AMB_TEST_RECIPIENT=
# Create a Sync service + map in Twilio Console; do not set a TTL on this map.
SYNC_SERVICE_SID=
SYNC_MAP_SID=
